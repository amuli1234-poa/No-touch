# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# WickSentinel Deriv OAuth authentication  (server-side only)
# ---------------------------------------------------------------------------
# These are read exclusively by the Node backend (server/index.ts). None of them
# are ever bundled into the frontend. Never commit real values — set them in the
# environment (e.g. a hosting provider's secret store or a local .env file).

# The Deriv application ID registered for WickSentinel (e.g. 12345).
DERIV_APP_ID=""

# A separate PAT-type Deriv application ID for manually pasted client tokens.
# Keep the OAuth app ID above for WickSentinel sign-in. PAT requests require a
# PAT-type app ID and the Deriv-App-ID header; do not reuse the OAuth app ID.
# Register this in the Deriv developer dashboard before enabling token entry.
DERIV_PAT_APP_ID=""

# The exact callback URL registered with Deriv. Must match character-for-character
# (scheme, host, path, no trailing slash). This is the route the backend serves.
# Example:
#   https://your-app.example.com/auth/deriv/callback
#   http://localhost:3000/auth/deriv/callback   (local development, via Vite)
DERIV_REDIRECT_URI=""

# Only required if the registered app is a confidential client. Deriv's
# documented public PKCE flow does not need it.
DERIV_CLIENT_SECRET=""

# Space-separated Deriv OAuth scopes. Keep the minimum for the current feature.
# Deriv's documented scopes are: trade, account_manage, application_read, payment.
# `trade` (default) both lists demo/real accounts and identifies the user, because
# `openid` is NOT an allowed scope for Deriv OAuth apps (Deriv returns
# invalid_scope). Add others only when a verified feature needs them.
DERIV_SCOPES="trade"

# Secret used to sign session cookies and encrypt tokens at rest.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Optional overrides.
# PORT=8787
# SESSION_TTL_SECONDS=604800
# DATA_DIR=./data
# NODE_ENV=production

# ---------------------------------------------------------------------------
# Redis cache  (optional)
# ---------------------------------------------------------------------------
# A cache, never a system of record. When REDIS_URL is set the server keeps hot,
# recomputable reads (the Deriv symbol catalogue, market snapshots and scanner
# readings) in Redis so repeated reads do not re-hit the upstream socket. If it
# is unset, or Redis is unreachable, an in-process cache is used and the app
# behaves exactly as before: no trade, session or signal depends on Redis.
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=wicksentinel:
# REDIS_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Execution kill switches  (server-side only)
# ---------------------------------------------------------------------------
# These independent flags gate EVERY purchase and the automatic scanner. They
# are read from the environment only — never from a request or the frontend — and
# all default to false. While they are false the Trade panel will show
# "Scanner off" and every trade is rejected with "Trading is switched off".
#
# To trade DEMO locally, uncomment the first two lines below and restart the
# backend. Leave ALLOW_REAL_EXECUTION unset (or false) — real money stays off.
#
# ALLOW_AUTOMATIC_TRADING is separate and defaults to false: manual trading can
# be on while automatic trading stays off, so nothing trades itself until you
# deliberately opt in. The scanner starts only when ALLOW_EXECUTION,
# ALLOW_DEMO_EXECUTION AND ALLOW_AUTOMATIC_TRADING are all true.
#
# ALLOW_EXECUTION=true
# ALLOW_DEMO_EXECUTION=true
# ALLOW_REAL_EXECUTION=false
# ALLOW_AUTOMATIC_TRADING=false

