    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "blockly": "^13.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crc-32": "^1.2.2",
    "date-fns": "^3.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "i18next": "^26.3.6",
    "ioredis": "^5.11.1",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next-themes": "^0.2.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-day-picker": "^9.0.0",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.11",
    "react-resizable-panels": "^4.24.3",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "undici": "^7.30.1",
    "uuid": "^11.1.1",
    "vaul": "^1.1.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
