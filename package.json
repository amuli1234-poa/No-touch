{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:all": "sh -c 'tsx server/index.ts & vite --port=3000 --host=0.0.0.0'",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:server": "tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "test:auth": "tsx server/tests/auth.test.ts",
    "test:admin": "tsx server/tests/admin.test.ts",
    "test:copy-admin": "tsx server/tests/copy_trading_admin.test.ts",
    "test:store": "tsx server/tests/store_lock.test.ts",
    "test:migrate": "tsx server/tests/migration.test.ts",
    "test:telemetry": "tsx server/tests/telemetry.test.ts",
    "test:balance": "tsx server/tests/balance.test.ts",
    "test:copy-balance": "tsx server/tests/copy_trading_balance.test.ts",
    "test:copy-readiness": "tsx --test server/tests/copy_trading_readiness.test.ts",
    "test:isolation": "tsx server/tests/isolation.test.ts",
    "test:market": "tsx server/tests/market_data.test.ts",
    "test:signals": "tsx server/tests/signals.test.ts",
    "test:risk": "tsx server/tests/risk.test.ts",
    "test:execution": "tsx server/tests/execution.test.ts",
    "test:broker": "tsx server/tests/broker.test.ts",
    "test:exec-routes": "tsx server/tests/execution_routes.test.ts",
    "test:auto": "tsx server/tests/auto_runner.test.ts",
    "test:monitor": "tsx server/tests/contract_monitor.test.ts",
    "test:security": "tsx server/tests/execution_security.test.ts",
    "test:forward": "tsx server/tests/forward_test.test.ts",
    "test:real-gate": "tsx server/tests/real_release_gate.test.ts",
    "test:copy-engine": "tsx server/tests/copy_trading_engine.test.ts",
    "test:bots": "tsx server/tests/bot_parser.test.ts",
    "test:bot-import": "tsx server/tests/bot_import.test.ts",
    "test:bot-run": "tsx server/tests/bot_run.test.ts",
    "test:bot-markets": "tsx server/tests/bot_markets.test.ts",
    "test:interpreter": "tsx server/tests/interpreter.test.ts",
    "test:server": "tsx --test --test-concurrency=1 $(find server/tests -name '*.test.ts')",
    "db:migrate": "tsx server/store/migrate.ts",
    "db:migrate:postgres": "tsx server/store/migrate_postgres.ts",
    "db:import:postgres": "tsx server/store/import_to_postgres.ts",
    "admin:bootstrap": "tsx server/admin/bootstrap.ts",
    "dev:admin": "vite --config admin/vite.config.ts --port=3001 --host=0.0.0.0",
    "build:admin": "vite build --config admin/vite.config.ts",
    "lint:admin": "tsc --noEmit -p admin/tsconfig.json",
    "build:bot": "npm --prefix bot-app install --legacy-peer-deps && npm --prefix bot-app run build:bot",
    "dev:bot": "npm --prefix bot-app run dev"
  },
  "dependencies": {
    "@deriv-com/smartcharts-champion": "^1.10.8",
    "@deriv-com/translations": "^1.6.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
